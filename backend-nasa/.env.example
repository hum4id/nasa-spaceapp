# Copy to .env. Never commit .env.
APP_ENV=development
APP_PORT=8000
# Comma-separated list; wildcard '*' is rejected.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATA_DIR=datasets
MODELS_DIR=models
LOG_LEVEL=INFO
# text for local, json for containers
LOG_FORMAT=text
RATE_LIMIT_DEFAULT=120/minute
# Behind a reverse proxy: uvicorn --proxy-headers trusts X-Forwarded-For only from these IPs
FORWARDED_ALLOW_IPS=127.0.0.1
# Optional until a module needs them (install extras: db, cache)
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5432/nasa_space_app
# REDIS_URL=redis://localhost:6379/0
